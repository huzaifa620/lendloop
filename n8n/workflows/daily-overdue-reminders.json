            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LLerrorHandler01"
  },
  "pinData": {},
  "active": false,
  "tags": []
}
