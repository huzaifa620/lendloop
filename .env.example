# Copy to .env.local (git-ignored). Never commit real values.

# --- Next.js app -------------------------------------------------------------
# Written for you by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# --- Convex deployment --------------------------------------------------------
# These live on the Convex deployment, not in this file. Set them with
# `npx convex env set NAME value` (the last two are set by `npm run setup:automation`).
#
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev   # Clerk Frontend API URL
# LENDLOOP_WEBHOOK_SECRET=<generated>                            # HMAC secret, shared with n8n
# N8N_NOTIFY_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-events

# --- n8n (docker-compose.yml) ------------------------------------------------
# Optional. Where n8n reaches Convex HTTP actions. Put it in a `.env` file next
# to docker-compose.yml or export it before `docker compose up`.
# Default: http://host.docker.internal:3211 (a local Convex deployment).
# LENDLOOP_CONVEX_SITE_URL=https://your-deployment.convex.site
